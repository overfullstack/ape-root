  {"key":"baseUrl","value":"https://example.salesforce.com"},
  {"key":"username","value":"user@example.com"},
  {"key":"password","value":"password123"},
  {"key":"accessToken","value":"00XXX!AQEAQGrZHtuMgDxk..."},
  {"key":"orderId","value":"801LT00000j9xyz"},
  {"key":"billingOpsUserName","value":"billingOps-user@example.com"},
  {"key":"percentage1","value":"20"},
  {"key":"percentage2","value":"30"},
  {"key":"percentage3","value":"50"}
]
```

